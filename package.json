{
  "name": "critter-sounds",
  "productName": "Critter Sounds",
  "version": "1.4.0",
  "description": "Critter Sounds: plays your music to a Critter table, live, with fades and effects.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build-www": "node build.mjs",
    "start": "node build.mjs && electron .",
    "dist": "node build.mjs && electron-builder --win dir && node installer/pack.mjs"
  },
  "build": {
    "appId": "app.critboard.music",
    "productName": "Critter Sounds",
    "npmRebuild": false,
    "files": [
      "!node_modules/node-webcodecs/**/*",
      "main.js",
      "preload.js",
      "assets/**/*",
      "nodes-guide/**/*",
      "bots/**/*",
      "www/**/*",
      "updater.js",
      "update.html",
      "update-preload.js"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "dir",
      "icon": "build/icon.ico"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "booskers",
        "repo": "critter-sounds"
      }
    ]
  },
  "critterSetup": {
    "name": "Critter Sounds",
    "accent": "#8800ff",
    "dataDirs": [
      "Critter Sounds",
      "Critter Music",
      "Critboard Music"
    ],
    "artifactName": "Critter-Sounds-Setup"
  },
  "devDependencies": {
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.2"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "@fluxerjs/core": "^3.2.0",
    "@fluxerjs/voice": "^3.1.0",
    "@noble/ciphers": "^2.4.0",
    "discord.js": "^14.27.0",
    "electron-updater": "^6.8.9",
    "opusscript": "^0.0.8",
    "prism-media": "^1.3.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/booskers/critter-sounds.git"
  },
  "license": "MIT"
}
